  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelFourDialogue
  textDisplay: {fileID: 0}
  dialoguePanel: {fileID: 0}
  audioSource: {fileID: 8952439527815236783}
  solTypeSound: {fileID: 8300000, guid: 9bbeaa28c4e5a2d4aa749e1d2a2bb5e7, type: 3}
  mageTypeSound: {fileID: 8300000, guid: 75fba2056a44a6943a62df10abebc50f, type: 3}
  playerMovementScript: {fileID: 0}
  mainCamera: {fileID: 0}
  solTransform: {fileID: 0}
  mageTransform: {fileID: 4998060357572453184}
  defaultCamSize: 5
  zoomCamSize: 3
  cameraSpeed: 5
  dialogueLines:
  - 'Mage: Have you now learned the cruel reality of life?'
  - 'Sol: Yeah, the only cruel thing is your 5 second lightning countdown.'
  - 'Mage: And so you are ready to return to me.'
  - 'Sol: Hah. You think I want to return? I may have been struck by lightning but
    at least I was able to live life without being under your control.'
  - 'Sol: That''s enough for me.'
  - 'Mage: ... Then let me accelerate your demise. Three seconds now, lets see how
    long you last, you vermin wretch.'
  textSpeed: 0.04
