  m_Script: {fileID: 11500000, guid: 18678b4b4b0c8a34281e4c66c8534edf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTest
  textDisplay: {fileID: 752401553}
  dialoguePanel: {fileID: 1258870129}
  audioSource: {fileID: 1792324627}
  typeSound: {fileID: 8300000, guid: 9bbeaa28c4e5a2d4aa749e1d2a2bb5e7, type: 3}
  startDelay: 2
  playerMovementScript: {fileID: 0}
  mainCamera: {fileID: 2065726236}
  solTransform: {fileID: 1699042449}
  mageTransform: {fileID: 432186120}
  defaultCamSize: 5
  zoomCamSize: 3
  cameraSpeed: 5
  testLines:
  - 'Sol (Internal): Many people talk about the treasure of living... fulfilling
    dreams before time strikes and calls for death.'
  - 'Sol (Internal): I wouldn''t know. For as long as I remember, I have been working
    for him.'
  - 'Sol (Internal): He named me Sol, and made me his slave. I have done nothing
    in life but carry out his tasks.'
  - 'Mage: SOL! Are you meaning to give me my mission updates.'
  - 'Sol: Oh uh yes sir, in terms of mission success... there is no success.'
  - 'Mage: Absolutely Scandalous! Have I not taught you the path to success, AND
    YET YOU STILL THRIVE TO BE THE FAILURE YOU ARE DESTINED TO BE.'
  - 'Sol: (This knob) I am sorry sir, it will not happen again. Probably. Maybe.
    I''m actually not certain- '
  - 'Mage: SILENCE! You insolent orphan. I give you meals, a roof over your head,
    and you still choose to speak your pity jokes. '
  - 'Sol: You expect me to be grateful to you? Since the day I existed you have made
    me your slave! I am more than just your worker, I deserve a life! '
  - 'Mage: ... You dare oppose me with such nonsense. You yearn for a life that you
    will never succeed in. '
  - 'Sol: I''d rather take my chances than live another second in your tyranny. '
  - 'Mage: FINE! Go on and try live your petty life, but you will never escape my
    wrath. From this day forward the sky itself will strike you down.  '
  - 'Mage: Now scaddle away. And I''ll be waiting for you to crawl back to me. '
  - 'Sol: Well... Crap- '
  textSpeed: 0.03
